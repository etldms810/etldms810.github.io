@charset "UTF-8";

@media screen and (max-width:1440px){
    .inner{width:94%;}
}
@media screen and (max-width:1030px){
    .allMenu > .mu_list .list_box li a{font-size:35px !important;}
}
@media screen and (max-width:935px){
    .allMenu > .mu_list .list_box.BOX1{margin-right:50px;}
}
@media screen and (max-width:881px){
	.allMenu > .mu_list.inner{width:80%}
    .allMenu > .mu_list{flex-direction:column; align-items:flex-start;}
    .allMenu > .mu_list .list_box.BOX1{margin-right:0px;}
    .allMenu > .mu_list .list_box li a{font-size:41px !important;}
}
@media screen and (max-width:630px){
    .allMenu > .mu_list .list_box li a{font-size:31px !important;}
	.allMenu > .mu_list{top:15%; transform:translateX(-50%); }
}
@media screen and (max-width:526px){
	.allMenu > .mu_list.inner{width:90%;}
}
@media screen and (max-width:436px){
    .allMenu > .mu_list .list_box li a{font-size:27px !important;}
	.allMenu > .mu_list{top:13%;}
}
@media screen and (max-width:380px){
    .allMenu > .mu_list .list_box li a{font-size:23px !important;}
}
@media screen and (max-width:346px){
    .allMenu > .mu_list .list_box li a{font-size:21px !important;}
}



/*inner*/
@media screen and (max-width:1780px){
    .thumbnail_inner{position:absolute; top:0; left:8%; height:100%; margin:0 auto;}
	.swiper-horizontal>.swiper-pagination-bullets, .swiper-pagination-bullets.swiper-pagination-horizontal, .swiper-pagination-custom, .swiper-pagination-fraction {left:8% !important;}
}
@media screen and (max-width:1440px){
    .thumbnail_inner > .Title > h2{font-size:81px;}
	.thumbnail_inner > .NTitle > h2{font-size:81px;}
	.mainSec01 .icoCircle {top:26%;}
	.mainSec01 > p{position:absolute; top:329px; right:-2%;}

	.mainSec01.viewMoreB .icoCircle,
	.mainSec01.viewMoreG .icoCircle,
	.mainSec01.viewMoreGF .icoCircle,
	.mainSec01.viewMoreWF .icoCircle{top:24%;}
	.mainSec01.viewMoreB > p,
	.mainSec01.viewMoreG > p,
	.mainSec01.viewMoreGF > p,
	.mainSec01.viewMoreWF > p{position:absolute; top:310px; right:-2%;}
	.mainSec01.viewMoreB:hover > p,
	.mainSec01.viewMoreG:hover > p,
	.mainSec01.viewMoreGF:hover > p,
	.mainSec01.viewMoreWF:hover > p{right:-5%;}
}

/*1024*/
@media screen and (max-width:1024px){
    .swiper.mySwiper{display:none;}
	.mobile_work{display:block;}
}
@media screen and (max-width:540px){
    .mobile_work > .inner li{margin:20px 0;}
}
@media screen and (max-width:430px){
    .mobile_work > .inner li{border-radius:17px;}
}


