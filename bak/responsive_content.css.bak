/*shinhan*/
@media screen and (max-width:1440px){
	.shinhanMobiles_mokup2.inner{width:70% !important;}
}
@media screen and (max-width:1024px){
	.shinhanMobiles_mokup2.inner{width:80% !important;}
	.shinhanMobiles_mokup2 > ul{column-count: 2; column-gap:10px;}
}
@media screen and (max-width:974px){
    .shinhan_Vis > .wise_mobile_Vis_inner > .txtBox > h2{font-size:61px;}
	.shinhan_Vis > .wise_mobile_Vis_inner > .txtBox > h2 span{top:-4px;}
	.shinhan_Vis > .wise_mobile_Vis_inner > .txtBox > h2 span img{max-width:100%; width:30px;}
}
@media screen and (max-width:788px){
    .shinhan_Vis > .wise_mobile_Vis_inner > .txtBox > h2{font-size:51px;}
	.shinhan_Vis > .wise_mobile_Vis_inner > .txtBox > h2 span img{max-width:100%; width:24px;}
}
@media screen and (max-width:655px){
    .shinhan_Vis > .wise_mobile_Vis_inner > .txtBox > h2{font-size:41px;}
	.shinhan_Vis > .wise_mobile_Vis_inner > .txtBox > h2 span img{max-width:100%; width:20px;}
}
@media screen and (max-width:580px){
    .shinhan_Vis > .wise_mobile_Vis_inner > .txtBox > h2{font-size:51px;}
}
@media screen and (max-width:430px){
