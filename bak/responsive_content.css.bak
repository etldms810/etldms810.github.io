/*wise_mobile_Vis*//**********************************************************************/
@media screen and (max-width:1440px){
    .wise_M_mokup > ul{column-gap:60px;}
}
@media screen and (max-width:1200px){
    .wise_M_mokup > ul{column-gap:40px;}
	.wise_mobile_Vis{height:850px;}
	.wise_mobile_Vis_inner .txtBox > h2{font-size:81px; line-height:1; margin-top:20px;}
}
@media screen and (max-width:1024px){
    .wise_M_mobiles_inner > .wise_M_mobiles_visual{background:url(../image/wise_mobile/wiseM_submobiles1200.jpg) no-repeat 0 center; height:634px; margin-top:100px;}
	.wise_mobile_Vis_inner > p{width:45%;}
    .wise_mobile_Vis_inner .txtBox{width:55%; }
	.wise_mobile_Vis_inner .txtBox > h2{font-size:75px;}
}
@media screen and (max-width:768px){
	.wise_mobile_Vis{height:700px;}
	.wise_mobile_Vis_inner .txtBox > h2{font-size:65px; margin-top:15px;}
}
@media screen and (max-width:680px){
    .wise_M_mobiles_inner > .wise_M_mobiles_visual{background:url(../image/wise_mobile/wiseM_submobiles680.jpg) no-repeat 0 center; height:360px; margin-top:50px;}
}
@media screen and (max-width:640px){
    .wise_M_mokup > ul{column-gap:20px;}
	.wise_mobile_Vis_inner .txtBox > h2{font-size:59px;}
}
@media screen and (max-width:580px){
	.wise_mobile_Vis_inner .txtBox{padding-top:80px;}
	.wise_mobile_Vis_inner .txtBox > p{font-size:17px; line-height:1;}
	.wise_mobile_Vis_inner .txtBox > h2{font-size:51px; margin-top:10px;}
	.wise_mobile_Vis_inner > p{display:flex; align-items:flex-end; height:65% !important;}
    .wise_mobile_Vis_inner .txtBox{width:100%; height:35% !important;}
	.wise_mobile_Vis_inner{flex-direction:column; align-items:center; height:100%;}
    .wise_mobile_Vis_inner .txtBox{display:block; height:auto;}
}
@media screen and (max-width:540px){
	.wise_mobile_Vis_inner > p{width:50%;}
}
@media screen and (max-width:480px){
	.wise_mobile_Vis_inner > p{width:55%;}
}
@media screen and (max-width:430px){
	.wise_mobile_Vis{height:600px;}
	.wise_mobile_Vis_inner > p{width:53%;}
	.wise_mobile_Vis_inner .txtBox{padding-top:50px;}
	.wise_mobile_Vis_inner .txtBox > h2{font-size:41px; margin-top:10px;}
}
@media screen and (max-width:414px){
	.wise_mobile_Vis_inner > p{width:55%;}
}
@media screen and (max-width:395px){
	.wise_mobile_Vis_inner > p{width:58%;}
}
@media screen and (max-width:385px){
	.wise_mobile_Vis_inner > p{width:60%;}
}
@media screen and (max-width:375px){
	.wise_mobile_Vis_inner > p{width:62%;}
}
@media screen and (max-width:360px){
	.wise_mobile_Vis_inner .txtBox{padding-top:70px;}
	.wise_mobile_Vis_inner > p{width:64%;}
}
@media screen and (max-width:320px){
	.wise_mobile_Vis{height:550px;}
	.wise_mobile_Vis_inner .txtBox{padding-top:70px;}
	.wise_mobile_Vis_inner > p{width:66%;}
	.wise_mobile_Vis_inner .txtBox > h2{font-size:31px; margin-top:10px;}
}

