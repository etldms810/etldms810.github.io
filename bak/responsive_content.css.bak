}
@media screen and (max-width:350px){
    .shinhan_Vis > .wise_mobile_Vis_inner > .txtBox > h2{font-size:37px;}
}
@media screen and (max-width:830px){
	.shinhanMobiles_mokup2.inner{width:94% !important;}
}
@media screen and (max-width:430px){
	.shinhanMobiles_mokup2 > ul{column-count: 1; column-gap:0px;}
}