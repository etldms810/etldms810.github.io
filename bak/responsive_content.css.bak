@charset "UTF-8";

/*home_btn*/
@media screen and (max-width:580px){
	.home_btn{top:30px; right:30px;}
	.home_btn img{max-width:100%; width:20px;}
}

/*preview_next*/
@media screen and (max-width:1024px){
	.preview_next > .preview_box{border-right:1px solid #000;}
    .preview_next > .preview_box > h2,
	.preview_next > .next_box > h2{font-size:21px; opacity:1;}
	.preview_next > .preview_box > h2 span img,
	.preview_next > .next_box > h2 span img{max-width:100%; width:18px;}
	.preview_next > .preview_box > span,
	.preview_next > .next_box > span{opacity:0.5;}
}
@media screen and (max-width:680px){
    .preview_next > .preview_box > h2,
	.preview_next > .next_box > h2{font-size:17px;}
}
@media screen and (max-width:570px){
    .preview_next{display:none;}
	.preview_next570{display:block;}
	.preview_next570 .preview a span,
	.preview_next570 .next a span{position:relative; top:-3px;}
}

/*topbtn*/
@media screen and (max-width:1700px){
    .topbtn{right:30px; bottom:40px; width:50px; height:50px; border-radius:50px;}
	.topbtn a span{font-size:25px; line-height:50px;}
}
@media screen and (max-width:1024px){
    .topbtn{display:none;}
}

 /*shinsegae*//***********************************************************************************************/
 /*shinsegae_vis*/
@media screen and (max-width:1440px){
    .shinsegae_vis{height:1020px;}
}
@media screen and (max-width:1350px){
    .shinsegae_vis{height:980px;}
}
@media screen and (max-width:1200px){
    .shinsegae_vis{height:900px;}
}
@media screen and (max-width:1024px){
    .shinsegae_vis{height:780px;}
	.shinsegae_vis_inner .txtBox > h2{font-size:71px; line-height:77px;}
}
@media screen and (max-width:830px){
    .shinsegae_vis{height:680px;}
	.shinsegae_vis_inner .txtBox > h2{font-size:67px; line-height:72px;}
}
@media screen and (max-width:667px){
    .shinsegae_vis{height:650px;}
	.shinsegae_vis_inner .txtBox{padding-top:150px;}
}
@media screen and (max-width:580px){
    .shinsegae_vis{height:600px;}
	.shinsegae_vis_inner .txtBox > h2{font-size:55px; line-height:61px;}
	.shinsegae_vis_inner .txtBox > p{font-size:17px; line-height:22px;}
	.shinsegae_vis_inner .txtBox > p span img{max-width:100%; width:25px;}
	.shinsegae_vis_inner .txtBox > p span{position:relative; top:-2px; margin-right:7px;}
}
@media screen and (max-width:480px){
    .shinsegae_vis{height:520px;}
	.shinsegae_vis_inner .txtBox{padding-top:130px;}
	.shinsegae_vis_inner .txtBox > h2{font-size:49px; line-height:55px;}
}
@media screen and (max-width:395px){
    .shinsegae_vis{height:450px;}
	.shinsegae_vis_inner .txtBox{padding-top:100px;}
	.shinsegae_vis_inner .txtBox > p{font-size:16px; line-height:21px;}
	.shinsegae_vis_inner .txtBox > p span img{max-width:100%; width:20px;}
	.shinsegae_vis_inner .txtBox > h2{font-size:41px; line-height:47px;}
}
@media screen and (max-width:360px){
    .shinsegae_vis{height:380px;}
	.shinsegae_vis_inner .txtBox{padding-top:100px;}
	.shinsegae_vis_inner .txtBox > p{font-size:16px; line-height:21px;}
	.shinsegae_vis_inner .txtBox > p span img{max-width:100%; width:20px;}
	.shinsegae_vis_inner .txtBox > h2{font-size:41px; line-height:47px;}
}

/*shinsegae_explanation*/
@media screen and (max-width:1200px){
    .shinsegae_explanation_inner > .bottomTxt > .Ltxt > h2,
	.shinsegae_explanation_inner > .bottomTxt > .Rtxt > h2{margin-right:30px;}
	.shinsegae_explanation_inner > .bottomTxt > .Rtxt .color > p{width:120px; border-top-right-radius:; border-bottom-left-radius:20px; margin-right:5px;}
}
@media screen and (max-width:1024px){
    .shinsegae_explanation_inner > .bottomTxt{display:block;}
	.shinsegae_explanation_inner > .bottomTxt > .Ltxt{margin-bottom:30px;}
	.shinsegae_explanation_inner > .bottomTxt > .Ltxt > h2,
	.shinsegae_explanation_inner > .bottomTxt > .Rtxt > h2{display:block; margin-right:70px; width:100px;}
	.shinsegae_explanation_inner > .bottomTxt > .Ltxt > p{width:calc(100% - 170px);}
	.shinsegae_explanation_inner > .bottomTxt > .Rtxt .color{width:calc(100% - 170px);}
	.shinsegae_explanation_inner > .bottomTxt > .Rtxt .color p{width:33.333%}
	.shinsegae_explanation_inner > .bottomTxt > .Ltxt > p br{display:none;}

	.shinsegae_explanation_inner > .topTxt{margin-bottom:80px;}
}
@media screen and (max-width:768px){
    .shinsegae_explanation_inner{padding:100px 0;}
	.shinsegae_explanation_inner > .topTxt > h2{font-size:16px;}
	.shinsegae_explanation_inner > .topTxt > h3{font-size:35px; line-height:41px;}
	.shinsegae_explanation_inner > .topTxt > p a{line-height:40px; width:170px; border-radius:20px; font-size:15px;}
	.shinsegae_explanation_inner > .topTxt > p a span{margin-left:10px;}
}
@media screen and (max-width:580px){
    .shinsegae_explanation_inner > .bottomTxt > .Ltxt > h2,
	.shinsegae_explanation_inner > .bottomTxt > .Rtxt > h2{font-size:17px; margin-right:50px;}
	.shinsegae_explanation_inner > .bottomTxt > .Ltxt > p{width:calc(100% - 150px); font-size:15px; line-height:22px;}
	.shinsegae_explanation_inner > .bottomTxt > .Rtxt .color{width:calc(100% - 150px);}
	.shinsegae_explanation_inner > .bottomTxt > .Rtxt .color > p{height:50px; border-top-right-radius:10px; border-bottom-left-radius:10px;}
}
@media screen and (max-width:360px){
    .shinsegae_explanation_inner > .bottomTxt > .Ltxt > h2,
	.shinsegae_explanation_inner > .bottomTxt > .Rtxt > h2{margin-right:20px;}
	.shinsegae_explanation_inner > .bottomTxt > .Ltxt > p{width:calc(100% - 120px);}
	.shinsegae_explanation_inner > .bottomTxt > .Rtxt .color{width:calc(100% - 120px);}
	.shinsegae_explanation_inner > .bottomTxt > .Rtxt .color > p{height:35px;}
}
@media screen and (max-width:480px){
	.shinsegae_explanation_inner > .topTxt > h2{font-size:15px;}
	.shinsegae_explanation_inner > .topTxt > h3{font-size:29px; line-height:35px;}
}
@media screen and (max-width:360px){
    .shinsegae_explanation_inner{padding:70px 0;}
	.shinsegae_explanation_inner > .topTxt > h3{font-size:27px; line-height:32px; margin-bottom:45px;}
}
/*shinsub_mokup*/
@media screen and (max-width:1440px){
	.shinsub_mokup_inner > .Lmokup{margin-right:100px;}
}
@media screen and (max-width:1200px){
    .shinsub_mokup_inner > .Lmokup > p,
	.shinsub_mokup_inner > .Rmokup > p{margin-bottom:50px;}
}
@media screen and (max-width:975px){
    .shinsub_mokup_inner{display:flex; padding:100px 0;}
	.shinsub_mokup_inner > .Lmokup{margin-right:50px;}
}
@media screen and (max-width:667px){
    .shinsub_mokup_inner{display:flex; padding:70px 0;}
}
@media screen and (max-width:580px){
    .shinsub_mokup_inner{display:flex; padding:50px 0;}
	.shinsub_mokup_inner > .Lmokup{margin-right:30px;}
    .shinsub_mokup_inner > .Lmokup > p,
	.shinsub_mokup_inner > .Rmokup > p{margin-bottom:30px; box-shadow:0 0 10px rgba(0,0,0,0.15);}
}
@media screen and (max-width:395px){
    .shinsub_mokup_inner{display:flex; padding:30px 0;}
	.shinsub_mokup_inner > .Lmokup{margin-right:20px;}
    .shinsub_mokup_inner > .Lmokup > p,
	.shinsub_mokup_inner > .Rmokup > p{margin-bottom:20px;}
}

/*shin_mobiles*/
@media screen and (max-width:1780px){
    .shin_mobiles_inner > .shin_mobiles_visual{height:700px;}
}
@media screen and (max-width:1200px){
    .shinMobiles_mokup{padding:140px 0;}
}
@media screen and (max-width:1024px){
    .shin_mobiles_inner > .shin_mobiles_visual{background:url(../image/shinsegae/submobiles1200.jpg) no-repeat center center; height:634px;}
    .banila_mobiles_inner > .banila_mobiles_visual{background:url(../image/banilaco/submobiles1200.jpg) no-repeat center center; height:634px;}
    .shinMobiles_mokup{padding:100px 0;}
	.shinMobiles_mokup > ul{column-count: 2; column-gap: 30px;}
	.shinMobiles_mokup > ul li{margin-bottom:30px;}
}
@media screen and (max-width:680px){
    .shin_mobiles_inner > .shin_mobiles_visual{background:url(../image/shinsegae/submobiles680.jpg) no-repeat center center; height:360px;}
    .banila_mobiles_inner > .banila_mobiles_visual{background:url(../image/banilaco/submobiles680.jpg) no-repeat center center; height:360px;}
	.shinMobiles_mokup > ul{column-gap: 20px;}
}
@media screen and (max-width:580px){
    .shinMobiles_mokup{padding:70px 0;}
}
@media screen and (max-width:540px){
    .shin_mobiles_inner > .shin_mobiles_visual{height:400px;}
}
@media screen and (max-width:455px){
	.shinMobiles_mokup > ul{column-count: 1; column-gap: 0;}
}
@media screen and (max-width:430px){
    .shinMobiles_mokup{padding:50px 0;}
	.shinMobiles_mokup > ul li{margin-bottom:20px;}
}
