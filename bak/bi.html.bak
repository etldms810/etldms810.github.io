<!DOCTYPE html>
<html lang="ko">
 <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport"  content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1"/>
	<meta name="format-detection" content="telephone=no">
    <title>Document</title>
    <link rel="stylesheet" href="../../css/reset.css" type="text/css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.../../css/4.1.1/animate.min.css">
	<link href="https://fonts.googleapis.com/css2?family=Material+Icons" rel="stylesheet">
	<!-- Add the slick css-->
    <link rel="stylesheet" type="text/css" href="http://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
    <link rel="stylesheet" type="text/css" href="http://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
    <!-- Add the js-->
	<script src="http://code.jquery.com/jquery-2.1.3.min.js"></script>
	<script type="text/JavaScript" src="../../js/jquery.slicknav.js"></script>
	<script type="text/javascript" src="http://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.9.0/slick.min.js"></script>
	<script>
		$(document).ready(function(){
			//gnb
			$('#gnb').slicknav();
			$("#gnb .head").click(function(){
				$(this).css("color","#ffcc00").next(".mu_list").slideToggle(300).siblings(".mu_list").slideUp(300);
				$(this).siblings("#gnb ,head").css("color","#fff");
			});
			// 대메뉴에서 특정 버튼에 마우스온할때
			$("#gnb > li > a").mouseover(function(){
				$(".nav-list > li.in_menu05 > a span img").attr("src","../../image/main/global43.png");
				$('#gnb > li > ul').slideDown('fast');
				$("#smenu_bar").slideDown();
				$("header").addClass("header_active1");
				$(".nav h1 img").attr("src","../../image/logo2_6.png");
				$(".nav-list > li > a").css("color","#000");
			});
			$(".nav-list > li.in_menu05").mouseover(function(){
				$(".nav-list > li.in_menu05 > a span img").attr("src","../../image/main/globalRed.png");
			});

			// 메뉴에서 마우스가 빠져나가면 메뉴를 닫는다
			$(".nav").mouseleave(function(){
				$(".nav-list > li.in_menu05 > a span img").attr("src","../../image/main/global.png");
				$('#gnb > li > ul').fadeOut('fast');
				$('#smenu_bar').fadeOut('fast');
				$("header").removeClass("header_active1");
				$(".nav h1 img").attr("src","../../image/logo1.png");
				$(".nav-list > li > a").css("color","#fff");
			});
			$(".nav-list > li.in_menu05").mouseleave(function(){
				$(".nav-list > li.in_menu05 > a span img").attr("src","../../image/main/global43.png");
			});
			$(".slicknav_menu").click(function(){ 
				$('header').css("background","#000");
				$(".slicknav_menu").click(function(){
					$('header').css("background","none");
				});
			});
			//FamilySite
			$(".family_btn").click(function(){
				if($(".family_box").css("display")=="none"){
					$(".family_box").slideDown();
					$(".family_btn img").attr("src","../../image/main/family_arrowA.png");
					$(".family_btn").css({
						border:"1px solid #db0b11",
					});
				}else{
					$(".family_box").slideUp();
					$(".family_btn img").attr("src","../../image/main/family_arrowD.png");
					$(".family_btn").css({
						border:"1px solid #c5c5c5",
					});
				}
			});
			//buttontab
			$(".buttontab_btn").click(function(){
				if($(".buttontab_box").css("display")=="none"){
					$(".buttontab_box").slideDown();
					$(".buttontab_btn img").attr("src","../../image/tabArrowA.png");
				}else{
					$(".buttontab_box").slideUp();
					$(".buttontab_btn img").attr("src","../../image/tabArrowD.png");
				}
			});
		});
	</script>
 </head>
