<!DOCTYPE html>
<html lang="ko">
 <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport"  content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1"/>
    <title>Document</title>
    <link rel="stylesheet" href="../css/reset.css" type="text/css">
	<link href="https://fonts.googleapis.com/css2?family=Material+Icons" rel="stylesheet">
	<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
	<!--js-->
    <script type="text/JavaScript" src="http://code.jquery.com/jquery-2.1.3.min.js"></script>
	<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.0.0/jquery.min.js"></script>
	<script>
		$(document).ready(function(){
			const line1 = document.querySelectorAll(".bg");
			const tl = gsap.timeline();
			const mu = gsap.timeline();
			const allMenu = gsap.timeline();
			const mu_list = gsap.timeline();

			$(".home_btn a").on("click",function(){
				$('.allMenu').stop().fadeIn(300);
				$('html, body').css({'overflow': 'hidden', 'height': '100%'});
			   
				tl.fromTo(line1,{opacity:0, scale:0},{duration:0.8, opacity:1, scale:100, xPercent:250, yPercent:250, delay:0.5, transformOrigin:"botton rihgt", ease: "power2.out",})
				mu.to('.mu',{duration:0.8, opacity:1,delay:1})
				mu_list.to('.mu_list',{duration:0.5, opacity:1,delay:1})

			});
			$(".closeBtn").on("click",function(){
				//$('.allMenu').stop().fadeOut(300);
				$('html, body').css({'overflow': '', 'height': ''});

				mu_list.to('.mu_list',{duration:0.3, opacity:0,})
				mu.to('.mu',{duration:0.3, opacity:0,})
				tl.to(line1,{duration:0.8, opacity:0, scale:0, xPercent:0, yPercent:0,delay:0.3, transformOrigin:"botton rihgt",ease: "power2.out",})
				allMenu.to('.allMenu',{duration:0.8, display:'none',delay:0.5})
			});
		});
	</script>
 </head>
 <body>
    <div class="wrap">
	    <!--home_btn-->
		<p class="home_btn"><a href="#"><img src="../image/ham_btn.png" alt="ham_btn"></a></p>
		<!--nav-->
		<div class="allMenu">
			<div class="mu_list">
				<ul class="list_box BOX1">
					<li><a href="#">신세계건설<b>RESPONSIVE FULL.JS</b></a></li>
					<li class="eng"><a href="#">BANILA CO<b>RESPONSIVE WEB</b></a></li>
					<li class="eng"><a href="#">GREENCAR<b>MD PROMOTION FULL.JS</b></a></li>
					<li class="eng"><a href="#">GREENCAR<b>MOBILE FIGMA</b></a></li>
					<li><a href="#">와이즈캠프<b>WEBSITE RENEWAL</b></a></li>
				</ul>
				<ul class="list_box">
					<li><a href="#">와이즈캠프<b>MOBILE</b></a></li>
					<li class="eng"><a href="#">INTERPARK<b>FUKUOKA</b></a></li>
					<li class="eng"><a href="#">EVENT PROMOTION<b>CHRISTMAS</b></a></li>
					<li><a href="#">서울대학교<b>SEOUL NATIONAL UNIVERSITY</b></a></li>
					<li class="eng"><a href="#">GODIVA<b>CAFE WEBSITE RENEWAL</b></a></li>
				</ul>
			</div>
			<div class="mu"><p class="closeBtn"><img src="../image/ham_btnB.png" alt="ham_btnB"></p></div>
			<div class="bg"></div>
		</div>
		<!--//home_btn-->
		<!--shinsegae_vis-->
		<div class="wise_mobile_Vis shinhan_Vis">
			<div class="wise_mobile_Vis_inner inner">
				<div class="txtBox">
					<p data-aos="fade-right" data-aos-duration="1000" data-aos-easing="ease-in-out"><span><img src="../image/shinhan/shinhanLogo.png" alt="shinhanLogo"></span>신한카드 앱 리뉴얼 피그마</p>
					<h2 data-aos="fade-right" data-aos-duration="1000" data-aos-easing="ease-in-out" data-aos-delay="300">SHINHAN CARD<br>APP FIGMA&nbsp;<span><img src="../image/shinhan/figmaLogo.png" alt="figmaLogo"></h2>
				</div>
				<p data-aos="fade-up" data-aos-duration="800" data-aos-easing="linear"><img src="../image/shinhan/vismokup.png" alt="vismokup"></p>
			</div>
		</div>
		<!--//shinsegae_vis-->
		<!--shinsegae_content-->
		<div class="shinsegae_content">
			<!--shinsegae_explanation-->
			<div class="shinsegae_explanation">
				<div class="shinsegae_explanation_inner shinhan_explanation_inner inner">
					<div class="topTxt">
						<h2>APP RENEWAL</h2>
						<h3>신한카드 앱<br>리뉴얼 피그마</h3>
					</div>
					<div class="bottomTxt">
						<div class="Ltxt">
							<h2>OVER VIEW</h2>
							<p>3D 아이콘와 요즘 유행하는 Glassmorphism을 <br>사용하여 리뉴얼 하였습니다. 신한 프렌즈와 브랜드 컬러를  <br>적극적으로 활용해 신한 브랜드의 아이덴티티가 잘 드러나게  <br>디자인 하였습니다.</p>
						</div>
						<div class="Rtxt">
							<h2>MAIN COLOR</h2>
							<div class="color">
								<p></p>
								<p></p>
								<p></p>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!--//shinsegae_explanation-->
			<!--shinmokuppull-->
			<div class="shin_mobiles">
				<div class="shin_mobiles_inner">
					<div class="shinMobiles_mokup shinhanMobiles_mokup inner">
						<ul>
							<li data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinhan/intro1.png" alt="intro1"></li>
							<li data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"data-aos-delay="300"><img src="../image/shinhan/intro2.png" alt="intro2"></li>
							<li data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"data-aos-delay="500"><img src="../image/shinhan/intro3.png" alt="intro3"></li>
						</ul>
					</div>
					<div class="shinhanMobiles_mokup2 inner">
						<ul>
							<li data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinhan/mokupPull1.png" alt="mokupPull1"></li>
							<li data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"data-aos-delay="300"><img src="../image/shinhan/mokupPull2.png" alt="mokupPull2"></li>
						</ul>
					</div>
				</div>
			</div>
			<!--//shinmokuppull-->
			<!--promotion_mokup-->
			<div class="promotion_mokup"><img src="../image/shinhan/shinhan_mokup.jpg" alt="shinhan_mokup"></div>
			<!--//promotion_mokup-->
		</div>
		<!--//shinsegae_content-->
		<!--topbtn-->
		<div class="topbtn" id="topbtn"><a href="#"><span class="material-icons">expand_less</span></a></div>
		<!--//topbtn-->
		<!--preview_next-->
		<div class="preview_next">
			<div class="preview_box" onclick="location.href='wise_mobile.html'">
				<p><img src="../image/arrowWise_M.jpg" alt="arrowGreen"></p>
				<h2><span><img src="../image/preview_arrow.png" alt="next_arrow"></span>&nbsp;&nbsp;PREVIEW WORK</h2>
				<span></span>
			</div>
			<div class="next_box" onclick="location.href='amore.html'">
				<p><img src="../image/arrowAmore.jpg" alt="arrowBanilaco"></p>
				<h2>NEXT WORK&nbsp;&nbsp;<span><img src="../image/next_arrow.png" alt="next_arrow"></span></h2>
				<span></span>
			</div>
		</div>
		<div class="preview_next570">
			<div class="preview_next570_inner">
				<p class="preview"><a href="#"><span><img src="../image/preview_arrow570.png" alt="next_arrow"></span>&nbsp;&nbsp;PREVIEW WORK</a></p>
				<p class="next"><a href="#">NEXT WORK&nbsp;&nbsp;<span><img src="../image/next_arrow570.png" alt="next_arrow"></span></a></p>
			</div>
		</div>
		<!--//preview_next-->
    </div>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.3/gsap.min.js"></script>
	<script>
		$(document).ready(function(){
			$(".shinsegae_explanation_inner > .topTxt > p").mouseover(function(){
				$(".shinsegae_explanation_inner > .topTxt > p a span img").attr("src","../image/shinsegae/sitelinkArrow_W.png");
			});
			$(".shinsegae_explanation_inner > .topTxt > p").mouseleave(function(){
				$(".shinsegae_explanation_inner > .topTxt > p a span img").attr("src","../image/greenPC/sitelinkArrow.png");
			});
			//topbtn
			$(window).scroll(function(){
				if($(this).scrollTop() > 1000){
					$(".topbtn").fadeIn("slow");
				}else{
					$(".topbtn").fadeOut("slow");
				}
			});
			$(".topbtn").click(function(){
				$("html,body").animate({
					scrollTop : "0"
				},600);
			});
			AOS.init({
				easing: 'ease-out-back',
			});
		});
	</script>
 </body>
</html>
