/*banila*//*****************************************************************************************************/
.banila_vis{background:#000 !important; height:1057px;}
.banila_vis_inner{position:relative;}
.banila_vis > .mov{position:absolute; width:100%; height:1057px !important; opacity:0.7;
	-webkit-opacity:0.7;
	-moz-opacity:0.7;
	-o-opacity:0.7;
}
.banila_vis > .mov > .myvideo{position:absolute; width:100%; height:1057px !important; top:0; left:0; background-size:100% 100%; background-position:center center; object-fit:cover; z-indez:3;}

.banila_explanation_inner > .topTxt > h2{color:#ff65af;}
.banila_explanation_inner > .topTxt > p a{border:1px solid #ff65af; color:#ff65af;}
.banila_explanation_inner > .topTxt > p a b{background:#ff65af;}
.banila_explanation_inner > .bottomTxt > .Rtxt .color > p{background:#ff65af;}

.banila_mobiles_inner > .banila_mobiles_visual{background:url(../image/banilaco/banila_submobiles.jpg) no-repeat 50% 0 fixed; background-size:cover; height:850px;}
