	-moz-flex-direction:column;
	-o-flex-direction:column;
	-webkit-justify-content:center;
	-moz-justify-content:center;
	-o-justify-content:center;
}
.wise_mobile_Vis_inner .txtBox > p{font-size:21px; line-height:27px; color:#fff; font-weight:200;}
.wise_mobile_Vis_inner .txtBox > p span{position:relative; top:-2px; margin-right:7px;}
.wise_mobile_Vis_inner .txtBox > h2{font-size:91px; line-height:97px; color:#fff; font-family: 'DM Serif Display';}

.wise_Mmokuppull_inner{width:806px; margin:0 auto;}
