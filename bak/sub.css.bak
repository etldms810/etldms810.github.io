/*wise_mobile_Vis*/
.wise_mobile_Vis{background:url(../image/wise_mobile/wise_mobile_Vis.jpg) no-repeat center center; background-size:cover; height:1057px;}
.wise_mobile_Vis_inner{display:flex; align-items:flex-end; height:100%;
	-webkit-display:flex;
	-moz-display:flex;
	-o-display:flex;
	-webkit-align-items:flex-end;
	-moz-align-items:flex-end;
	-o-align-items:flex-end;
}
.wise_mobile_Vis_inner > p{width:35%;}
.wise_mobile_Vis_inner > p img{width:100%;}

.wise_mobile_Vis_inner .txtBox{display:flex; flex-direction:column; justify-content:center; width:65%; height:100%;
