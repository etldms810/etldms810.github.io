/*wise_PC_Vis*//*****************************************************************************************************/
.wise_PC_vis{background:url(../image/wise_PC/wise_PC_Vis.jpg) no-repeat center center; background-size:cover; height:1057px;}

.wise_PC_explanation_inner > .topTxt > h2{color:#00aca5;}
