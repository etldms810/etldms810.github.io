@charset "UTF-8";
header{width:100%; position: absolute; top:0; left:0; height:90px; z-index:99999999998; transition:all 0.3s;
	-webkit-transition:all 0.3s;
	-moz-transition:all 0.3s;
	-o-transition:all 0.3s;
}

.logBox{position:absolute; top:30px; right:40px;}
.logBox > ul{display:flex;
	-webkit-display:flex;
	-moz-display:flex;
	-o-display:flex;
}
.logBox > ul > li{margin-left:40px;}

.navbar-nav{width:100%; position: absolute; top:70px; left:0; background:#fff;}
.main-wrapper img{
    width: 100%;
    display: block;
}
.main-wrapper a{
    color: #000;
    text-decoration: none;
}
.main-wrapper ul li{
    list-style-type: none;
}
.navbar{
    background: #fff;
	height:70px;
    padding: 0 1rem;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    max-height: 100vh;
    display: flex;
    flex-direction: column;
    z-index: 10;
	-webkit-display:flex;
	-moz-display:flex;
	-o-display:flex;
	-webkit-flex-direction: column;
	-moz-flex-direction: column;
	-o-flex-direction: column;
}
.brand-and-icon{
    display: flex;
    justify-content: space-between;
    padding: 1rem 0;
	-webkit-display:flex;
	-moz-display:flex;
	-o-display:flex;
}
.navbar-brand{
    position: absolute;
	top:22px;
	left:20px;
	z-index:99999999999;
}
.navbar-toggler{
	position:absolute;
	color:#ff65af;
	top:20px;
	right:20px;
    display: block;
    border: none;
    background: transparent;
    font-size: 23px;
    cursor: pointer;
    transition: all 0.4s ease;
	z-index:999999999999999999999999999999;
	-webkit-transition: all 0.4s ease;
	-moz-transition: all 0.4s ease;
	-o-transition: all 0.4s ease;
}
.navbar-toggler:hover{
    opacity: 0.7;
	-webkit-opacity: 0.7;
	-moz-opacity: 0.7;
	-o-opacity: 0.7;
}
.navbar-collapse{
    overflow-y: scroll;
    display: none;
}
.navbar-nav > li > a{
    font-size: 18px;
    font-weight: 300;
	padding:10px 20px;
    display: block;
    border-bottom: 1px solid #ddd;
    border-radius: 1px;
    position: relative;
    transition: all 0.4s ease;
	-webkit-border-radius: 1px;
	-moz-border-radius: 1px;
	-o-border-radius: 1px;
	-webkit-transition: all 0.4s ease;
	-moz-transition: all 0.4s ease;
	-o-transition: all 0.4s ease;
}
.drop-icon{
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
	-webkit-transform: translateY(-50%);
	-moz-transform: translateY(-50%);
	-o-transform: translateY(-50%);
}
.navbar-nav > li > a:hover{
    color:#ff65af;
}
.sub-menu h4{
    text-transform: capitalize;
    font-size: 1rem;
    padding: 0.5rem 0;
}
.sub-menu ul li{
    text-transform: capitalize;
    padding: 0.2rem 0;
    margin: 0.2rem 0;
    font-size: 0.95rem;
}
.sub-menu ul li a{
    opacity: 0.8;
    transition: all 0.3s ease;
	-webkit-opacity: 0.8;
	-moz-opacity: 0.8;
	-o-opacity: 0.8;

}
.sub-menu ul li a:hover{
	color:#ff65af;
    opacity: 0.9;
	-webkit-opacity: 0.9;
	-moz-opacity: 0.9;
	-o-opacity: 0.9;
}
.sub-menu{
    display: none;
}

.sub-menu-item{
    padding-left: 1.2rem;
}
.sub-menu-item:nth-child(3){
    background:url(../image/nav1.jpg) no-repeat;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-top: 2rem;
    padding-bottom: 2rem;
	display:none;
	-webkit-display: flex;
	-moz-display: flex;
	-o-display: flex;
	-webkit-flex-direction: column;
	-moz-flex-direction: column;
	-o-flex-direction: column;
	-webkit-justify-content: center;
	-moz-justify-content: center;
	-o-justify-content: center;
	-webkit-align-items: flex-start;
	-moz-align-items: flex-start;
	-o-align-items: flex-start;
}
.sub-menu-item:nth-child(3) h2{
    text-transform: capitalize;
    margin: 1.5rem 0;
	font-size:19px;
	font-weight:300;
}
.sub-menu-item:nth-child(3) h2 b{
	font-weight:400;
}
.sub-menu-item:nth-child(3) .btn{
    text-transform: uppercase;
    font-size: 0.9rem;
    padding: 0.6rem 1rem;
    cursor: pointer;
    background: #ff65af;
    color: #fff;
	border-radius:30px;
    transition: all 0.5s ease;
	-webkit-border-radius:30px;
	-moz-border-radius:30px;
	-o-border-radius:30px;
	-webkit-transition: all 0.5s ease;
	-moz-transition: all 0.5s ease;
	-o-transition: all 0.5s ease;
}
.sub-menu-item:nth-child(3) .btn:hover{
    background:#fff;
    color: #ff65af;
}
.sub-menu-item:nth-child(4){
    width: 50%;
    margin: 0 auto;
    padding: 20px 0;
	display:none;
}


/* Media Queries */
@media screen and (min-width: 1024px){
	.navbar-nav{top:0; background:none;}
    .navbar{
	    height:auto;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        border-bottom: 1px solid #ddd;
        position: relative;
    }
    .navbar-toggler{
        display: none;
    }
    .brand-and-icon{
        flex: 0 0 100px;
        border-bottom: none;
        padding: 0;
		-webkit-flex: 0 0 100px;
		-moz-flex: 0 0 100px;
		-o-flex: 0 0 100px;
    }
    .navbar-collapse{
        display: block!important;
        overflow-y: hidden;
        flex: 1 0 auto;
		-webkit-flex: 1 0 auto;
		-moz-flex: 1 0 auto;
		-o-flex: 1 0 auto;
    }
    .navbar-nav{
        display: flex;
        align-items: center;
        justify-content: center;
		-webkit-display: flex;
		-moz-display: flex;
		-o-display: flex;
		-webkit-align-items: center;
		-moz-align-items: center;
		-o-align-items: center;
		-webkit-justify-content: center;
		-moz-justify-content: center;
		-o-justify-content: center;
    }
	.navbar-nav > li{text-align:center;}
    .navbar-nav > li > a{
        border-bottom: none;
		line-height:88px;
		width:150px;
		font-size:18px;
		padding:0;
    }
    .sub-menu{
        position: absolute;
        left: 0;
        width: 100%;
        top: 90px;
        background: #f8f8f8;
    }
    .navbar-nav > li:hover .sub-menu{
        display: grid!important;
        grid-template-columns: repeat(4, 1fr);
        padding: 0 5rem;
    }
    .navbar-nav > li{
        border-bottom: 2px solid transparent;
        transition: border-bottom 0.4s ease;
    }
    .navbar-nav > li:hover{
        border-bottom-color: #ff65af;
    }
    .sub-menu-item{
        padding-left: 0;
		padding-top:20px;
    }
    .sub-menu-item:nth-child(3){
        padding-left: 2rem;
        padding-right: 2rem;
		display:block;
    }
	.sub-menu-item:nth-child(4){
		display:block;
    }
	.navbar-brand{
		top:30px;
		left:40px;
	}
}

@media screen and (max-width: 1200px){
    .navbar-nav{
        justify-content: flex-end;
		-webkit-justify-content: flex-end;
		-moz-justify-content: flex-end;
		-o-justify-content: flex-end;
    }
	.logBox{display:none;}
}
@media screen and (max-width: 580px){
    .navbar-brand{top:28px; left:30px;}
    .navbar-brand img{max-width:100%; width:130px;}
}