<!DOCTYPE html>
<html lang="ko">
 <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport"  content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1"/>
    <title>Document</title>
    <link rel="stylesheet" href="../css/reset.css" type="text/css">
	<link href="https://fonts.googleapis.com/css2?family=Material+Icons" rel="stylesheet">
	<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
	<!--js-->
    <script type="text/JavaScript" src="http://code.jquery.com/jquery-2.1.3.min.js"></script>
	<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.0.0/jquery.min.js"></script>
	<script>
		$(document).ready(function(){
			const line1 = document.querySelectorAll(".bg");
			const tl = gsap.timeline();
			const mu = gsap.timeline();
			const allMenu = gsap.timeline();
			const mu_list = gsap.timeline();

			$(".home_btn a").on("click",function(){
				$('.allMenu').stop().fadeIn(300);
				$('html, body').css({'overflow': 'hidden', 'height': '100%'});
			   
				tl.fromTo(line1,{opacity:0, scale:0},{duration:0.8, opacity:1, scale:100, xPercent:250, yPercent:250, delay:0.5, transformOrigin:"botton rihgt", ease: "power2.out",})
				mu.to('.mu',{duration:0.8, opacity:1,delay:1})
				mu_list.to('.mu_list',{duration:0.5, opacity:1,delay:1})

			});
			$(".closeBtn").on("click",function(){
				//$('.allMenu').stop().fadeOut(300);
				$('html, body').css({'overflow': '', 'height': ''});

				mu_list.to('.mu_list',{duration:0.3, opacity:0,})
				mu.to('.mu',{duration:0.3, opacity:0,})
				tl.to(line1,{duration:0.8, opacity:0, scale:0, xPercent:0, yPercent:0,delay:0.3, transformOrigin:"botton rihgt",ease: "power2.out",})
				allMenu.to('.allMenu',{duration:0.8, display:'none',delay:0.5})
			});
		});
	</script>
 </head>
 <body>
    <div class="wrap">
	    <!--home_btn-->
		<p class="home_btn"><a href="#"><img src="../image/ham_btn.png" alt="ham_btn"></a></p>
		<!--nav-->
		<div class="allMenu">
			<div class="mu_list inner">
				<ul class="list_box BOX1">
					<li><a href="sub/shinsegae.html">신세계건설<b>RESPONSIVE FULL.JS</b></a></li>
					<li class="eng"><a href="sub/banilaco.html">BANILA CO<b>RESPONSIVE WEB</b></a></li>
					<li class="eng"><a href="sub/greenCar_PC.html">GREENCAR<b>MD PROMOTION FULL.JS</b></a></li>
					<li class="eng"><a href="sub/green_figma.html">GREENCAR<b>MOBILE FIGMA</b></a></li>
					<li><a href="sub/wise_PC.html">와이즈캠프<b>WEBSITE RENEWAL</b></a></li>
				</ul>
				<ul class="list_box">
					<li><a href="sub/wise_mobile.html">와이즈캠프<b>MOBILE</b></a></li>
					<li><a href="sub/shinhan.html">신한카드<b>APP RENEWAL</b></a></li>
					<li class="eng"><a href="sub/amore.html">EVENT PROMOTION<b>CHRISTMAS</b></a></li>
					<li class="eng"><a href="sub/interpark.html">INTERPARK<b>FUKUOKA</b></a></li>
					<li><a href="sub/seoul.html">서울대학교<b>SEOUL NATIONAL UNIVERSITY</b></a></li>
				</ul>
			</div>
			<div class="mu"><p class="closeBtn"><img src="../image/ham_btnB.png" alt="ham_btnB"></p></div>
			<div class="bg"></div>
		</div>
		<!--//home_btn-->
		<!--shinsegae_vis-->
		<div class="shinsegae_vis">
			<div class="shinsegae_vis_inner inner">
				<div class="txtBox">
					<p data-aos="fade-right" data-aos-duration="1000" data-aos-easing="ease-in-out"><span><img src="../image/shinsegae/flower.png" alt="flower"></span>신세계 건설 웹 사이트 반응형 리뉴얼</p>
					<h2 data-aos="fade-right" data-aos-duration="1000" data-aos-easing="ease-in-out" data-aos-delay="300">SHINSEGAE E&C</h2>
				</div>
				<p data-aos="fade-up" data-aos-duration="800" data-aos-easing="linear"><img src="../image/shinsegae/vismokup.png" alt="vismokup"></p>
			</div>
		</div>
		<!--//shinsegae_vis-->
		<!--shinsegae_content-->
		<div class="shinsegae_content">
			<!--shinsegae_explanation-->
			<div class="shinsegae_explanation">
				<div class="shinsegae_explanation_inner inner">
					<div class="topTxt">
						<h2>Responsive Renewal</h2>
						<h3>신세계 건설<br>웹 사이트 반응형 리뉴얼</h3>
						<p><a href="../work/SHINSEGAE/index.html">SITE LINE<span><img src="../image/shinsegae/sitelinkArrow.png" alt="sitelinkArrow"></span><b></b></a></p>
					</div>
					<div class="bottomTxt">
						<div class="Ltxt">
							<h2>OVER VIEW</h2>
							<p>기존 사이트의 이용성의 불편함을 덜고 신세계의 세련되고, <br>깔끔한 느낌을 살려 리뉴얼 하였습니다. 사용자의 편의를 위해 <br>반응형으로 제작하여 다양한 디바이스에서 접속 가능합니다.</p>
						</div>
						<div class="Rtxt">
							<h2>MAIN COLOR</h2>
							<div class="color">
								<p></p>
								<p></p>
								<p></p>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!--//shinsegae_explanation-->
			<!--shinmokuppull-->
			<div class="shinmokuppull">
				<div class="shinmokuppull_inner inner">
					<p data-aos="fade-down" data-aos-duration="800" data-aos-easing="linear"><img src="../image/shinsegae/mainmokuppull.png" alt="mainmokuppull"></p>

				</div>
			</div>
			<!--//shinmokuppull-->
			<!--shinsub_mokup-->
			<div class="shinsub_mokup">
				<div class="shinsub_mokup_inner inner">
					<div class="Lmokup">
						<p data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinsub_mokup1.jpg" alt="shinsub_mokup1"></p>
						<p data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinsub_mokup2.jpg" alt="shinsub_mokup2"></p>
						<p data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinsub_mokup3.jpg" alt="shinsub_mokup3"></p>
						<p data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinsub_mokup4.jpg" alt="shinsub_mokup4"></p>
						<p data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinsub_mokup5.jpg" alt="shinsub_mokup5"></p>
					</div>
					<div class="Rmokup">
						<p data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out" data-aos-delay="500"><img src="../image/shinsegae/shinsub_mokup6.jpg" alt="shinsub_mokup6"></p>
						<p data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinsub_mokup7.jpg" alt="shinsub_mokup7"></p>
						<p data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinsub_mokup8.jpg" alt="shinsub_mokup8"></p>
						<p data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out" data-aos-delay="500"><img src="../image/shinsegae/shinsub_mokup9.jpg" alt="shinsub_mokup9"></p>
						<p data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinsub_mokup10.jpg" alt="shinsub_mokup10"></p>
					</div>
				</div>
			</div>
			<!--//shinsub_mokup-->
			<!--shin_mobiles-->
			<div class="shin_mobiles">
				<div class="shin_mobiles_inner">
					<div class="shin_mobiles_visual"><!-- <img src="../image/shinsegae/submobiles.jpg" alt="submobiles"> --></div>
					<div class="shinMobiles_mokup inner">
						<ul>
							<li class="shinMobiles_mokupP1" data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinMobiles_mokupP1.png" alt="shinMobiles_mokupP1"></li>
							<li class="shin_Mobile1" data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinMobiles_mokup1.jpg" alt="shinMobiles_mokup1"></li>
							<li class="shin_Mobile4" data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinMobiles_mokup4.jpg" alt="shinMobiles_mokup4"></li>
							<li class="shin_Mobile6" data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinMobiles_mokup6.jpg" alt="shinMobiles_mokup6"></li>
							<li class="shinMobiles_mokupP2" data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out" data-aos-delay="500"><img src="../image/shinsegae/shinMobiles_mokupP2.png" alt="shinMobiles_mokupP2"></li>
							<li class="shin_Mobile2" data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out" data-aos-delay="500"><img src="../image/shinsegae/shinMobiles_mokup2.jpg" alt="shinMobiles_mokup2"></li>
							<li class="shin_Mobile3" data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinMobiles_mokup3.jpg" alt="shinMobiles_mokup3"></li>
							<li class="shin_Mobile7" data-aos="fade-down" data-aos-duration="1000" data-aos-easing="ease-in-out"><img src="../image/shinsegae/shinMobiles_mokup7.jpg" alt="shinMobiles_mokup7"></li>
