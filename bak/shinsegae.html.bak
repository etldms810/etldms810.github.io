				<p><img src="../image/arrowSeoul.jpg" alt="arrowGreen"></p>
				<h2><span><img src="../image/preview_arrow.png" alt="next_arrow"></span>&nbsp;&nbsp;PREVIEW WORK</h2>
				<span></span>
			</div>
			<div class="next_box" onclick="location.href='banilaco.html'">
