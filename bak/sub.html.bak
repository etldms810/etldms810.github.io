 <script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.9.0/slick.min.js"></script>
 <script src="https://alexandrebuffet.fr/codepen/slider/slick-animation.min.js"></script>
 <script>
	$(document).ready(function(){
		//subteach_slider
		$(".subteach_slider").slick({
			autoplay: true,
			infinite: true,
			slidesToShow : 1,
			slidesToScroll: 1,
			dots : true,
			arrows : false,
			centerMode:true,
			centerPadding : '100px',
			responsive: [
				    {
						breakpoint: 481,
						settings: {
							centerPadding: '70px',
						}
				    },
                    {
						breakpoint: 431,
						settings: {
							centerPadding: '50px',
						}
				    },
				]
		});
		AOS.init({
				easing: 'ease-out-back',
			});
	});
 </script>
 </body>
</html>
